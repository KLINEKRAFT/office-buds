# Supabase Realtime powers the shared office (presence + broadcast only - no tables,
# no auth, no database schema). Create a free project at https://supabase.com, then
# copy Project Settings -> API into these two values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Without these the office still loads and is fully walkable - you are just the only
# one in it. Handy for working on the art and movement offline.
