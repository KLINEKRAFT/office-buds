{
  "name": "office-buds",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "assets": "python3 tools/build_sprites.py && python3 tools/build_office.py && python3 tools/build_village.py && python3 tools/build_font.py && python3 tools/build_icon.py",
    "test": "npm run test:build && node tests/run.mjs",
    "test:build": "tsc -p tsconfig.test.json && node tools/esm_fixup.mjs .testbuild",
    "test:browser": "npm run build && node tests/browser/game.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.7.2"
  }
}
